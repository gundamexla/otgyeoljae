<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MoaEngine</AssemblyName>
    <RootNamespace>VoltiEngine</RootNamespace>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <DefaultItemExcludes>$(DefaultItemExcludes);.build-cache/**</DefaultItemExcludes>
    <PlaywrightPlatform>win</PlaywrightPlatform>
  </PropertyGroup>
  <ItemGroup><Compile Remove="tests/**/*.cs" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="data/korean-places.json" LogicalName="VoltiEngine.KoreanPlaces.json" /></ItemGroup>
  <ItemGroup><PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" /></ItemGroup>
  <ItemGroup><PackageReference Include="Microsoft.Playwright" Version="1.64.1" /></ItemGroup>
  <!-- Playwright starts this driver as a separate process; it cannot be embedded in the engine EXE. -->
  <Target Name="KeepPlaywrightDriverExternal" AfterTargets="CopyPlaywrightFilesToOutput">
    <ItemGroup><Content Update="@(_PlaywrightCopyItems)"><ExcludeFromSingleFile>true</ExcludeFromSingleFile></Content></ItemGroup>
  </Target>
</Project>
