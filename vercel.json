{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npm --prefix moa-mobile ci --no-audit --no-fund",
  "buildCommand": "npm run build:mobile",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/mobile",
      "destination": "/mobile/index.html"
    },
    {
      "source": "/mobile/",
      "destination": "/mobile/index.html"
    }
  ]
}
